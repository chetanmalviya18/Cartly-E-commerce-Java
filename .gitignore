# ==========================================
# Cartly (Ecommerce) Root .gitignore
# ==========================================

# ------------------------------------------
# Dependencies & Build Outputs
# ------------------------------------------
node_modules/
**/node_modules/
dist/
dist-ssr/
build/
target/
**/target/
.mvn/timing.properties
.vite/

# ------------------------------------------
# Environment Variables & Local Configs
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
db.properties
**/db.properties

# ------------------------------------------
# Java / Compiled Class Files
# ------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
*.rar

# ------------------------------------------
# Log Files
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# IDE & Tooling Metadata
# ------------------------------------------
# Eclipse
.classpath
.project
.settings/
.factorypath
.springBeans

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.specs

# ------------------------------------------
# Temporary & Backup Files
# ------------------------------------------
*.tmp
*.bak
*.swp
*.swo
*~
