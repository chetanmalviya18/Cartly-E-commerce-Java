{
  "info": {
    "_postman_id": "cartly-api-v2",
    "name": "Cartly API v2",
    "description": "Complete Cartly e-commerce backend API covering Authentication, User, Category, and Product endpoints. Base URL: http://localhost:8080/Cartly",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/Cartly",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints. /register and /login are public. /logout requires authentication.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Register a new user account. Returns 201 Created with user details (no password)."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Authenticate a user. On success, server sets JSESSIONID session cookie which Postman stores automatically. Returns 200 OK with user details."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Invalidate the current session. Requires authentication (JSESSIONID cookie). Returns 204 No Content."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "description": "User profile endpoints. All endpoints require authentication.",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Get the currently authenticated user's profile. Requires valid JSESSIONID session cookie. Returns 200 OK with user details, or 401 Unauthorized if not logged in, or 404 if user not found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Category management endpoints. GET endpoints are public. POST and PUT require authentication.",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "description": "Retrieve all categories ordered by name. Returns 200 OK with array of category objects."
          },
          "response": []
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "1"]
            },
            "description": "Retrieve a single category by its ID. Returns 200 OK with category object, or 404 Not Found if category does not exist."
          },
          "response": []
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\"\n}"
            },
            "description": "Create a new category. Requires authentication. 'name' is required and must be unique. 'description' is optional (max 500 chars). Returns 201 Created with created category."
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description for electronics\"\n}"
            },
            "description": "Update an existing category by ID. Requires authentication. Both 'name' and 'description' are accepted. Returns 200 OK with updated category, or 400 if name already taken."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "description": "Product management endpoints. GET endpoints are public. POST, PUT, DELETE require authentication.",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Retrieve all active products. Returns 200 OK with array of product objects."
          },
          "response": []
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "1",
                  "description": "Filter products by category ID"
                }
              ]
            },
            "description": "Retrieve all products belonging to a specific category. Pass 'categoryId' as a query parameter. Returns 200 OK with filtered product array."
          },
          "response": []
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=phone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "search",
                  "value": "phone",
                  "description": "Search keyword to match product names"
                }
              ]
            },
            "description": "Search products by name keyword using the 'search' query parameter. Returns 200 OK with matching product array."
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Retrieve a single product by its ID. Returns 200 OK with product object, or 404 Not Found if product does not exist."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 16 Pro\",\n  \"description\": \"Apple iPhone 16 Pro 256GB\",\n  \"price\": 134900.00,\n  \"stock\": 50,\n  \"categoryId\": 1,\n  \"imageUrl\": \"https://example.com/images/iphone16pro.jpg\"\n}"
            },
            "description": "Create a new product. Requires authentication. 'name', 'price', and 'categoryId' are required. 'description', 'stock', and 'imageUrl' are optional. price must be > 0. stock must be >= 0. Returns 201 Created with created product."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 16 Pro Max\",\n  \"description\": \"Apple iPhone 16 Pro Max 512GB\",\n  \"price\": 159900.00,\n  \"stock\": 30,\n  \"categoryId\": 1,\n  \"imageUrl\": \"https://example.com/images/iphone16promax.jpg\"\n}"
            },
            "description": "Update an existing product by ID. Requires authentication. All fields can be updated. Returns 200 OK with updated product, or 404 if product not found."
          },
          "response": []
        },
        {
          "name": "Deactivate Product (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Soft-delete a product by setting active=false. Product is not permanently deleted from the database. Requires authentication. Returns 204 No Content on success, or 404 if product not found."
          },
          "response": []
        }
      ]
    }
  ]
}
